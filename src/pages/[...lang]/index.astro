---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getLang, href, langParams, pick, useT } from '../../i18n';
import { getPeople, getProjects, getThemes, projectsOf, roleOrder } from '../../lib/data';

export function getStaticPaths() {
  return langParams;
}

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const [projects, people, themes, newsAll] = await Promise.all([
  getProjects(),
  getPeople(),
  getThemes(),
  getCollection('news'),
]);
const news = newsAll.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 8);
const pi = people.find((p) => p.data.role === 'pi');
const groups = roleOrder
  .filter((r) => r !== 'pi')
  .map((role) => ({ role, members: people.filter((p) => p.data.role === role) }))
  .filter((g) => g.members.length);
const types = (['paper', 'dataset', 'code', 'demo'] as const).filter((ty) => projects.some((p) => p.data.type === ty));
const memberCount = people.filter((p) => p.data.role !== 'alumni').length;
const fmtDate = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
---

<Base lang={lang}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{t('site.affiliation')}</p>
      <h1>{t('hero.title')}</h1>
      <p class="lede">{t('hero.lede')}</p>
      <div class="cta">
        <a class="btn" href="#projects">{t('hero.browse')} →</a>
        <a class="btn ghost" href="#join">{t('hero.join')}</a>
      </div>
      <dl class="stats">
        <div><dt>{t('stats.themes')}</dt><dd>{themes.length}</dd></div>
        <div><dt>{t('stats.projects')}</dt><dd>{projects.length}</dd></div>
        <div><dt>{t('stats.members')}</dt><dd>{memberCount}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section" id="research">
    <div class="wrap">
      <div class="sec-head">
        <h2>{t('nav.research')}</h2>
        <p>{t('research.intro')}</p>
      </div>
      <div class="themes">
        {
          themes.map((th) => (
            <a class="theme" href={`#projects`} data-pick-theme={th.id}>
              <span class="code">{th.data.code}</span>
              <h3>{pick(th.data.name, lang)}</h3>
              <p>{pick(th.data.description, lang)}</p>
              <span class="count">
                {projects.filter((p) => p.data.theme.id === th.id).length} {t('stats.projects')} →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="wrap">
      <div class="sec-head">
        <h2>{t('nav.projects')}</h2>
        <p>{t('projects.intro')}</p>
      </div>
      <div class="filters" id="filters">
        <div class="grp" role="group" aria-label={t('filter.theme')}>
          <span class="lab">{t('filter.theme')}</span>
          <button class="chip" data-f="theme" data-v="" aria-pressed="true">{t('filter.all')}</button>
          {
            themes.map((th) => (
              <button class="chip" data-f="theme" data-v={th.id} aria-pressed="false">
                {th.data.code} {pick(th.data.name, lang)}
              </button>
            ))
          }
        </div>
        <div class="grp" role="group" aria-label={t('filter.type')}>
          <span class="lab">{t('filter.type')}</span>
          <button class="chip" data-f="type" data-v="" aria-pressed="true">{t('filter.all')}</button>
          {
            types.map((ty) => (
              <button class="chip" data-f="type" data-v={ty} aria-pressed="false">
                {t(`type.${ty}`)}
              </button>
            ))
          }
        </div>
      </div>
      <div class="list" id="projectList">
        {projects.map((p) => <ProjectRow project={p} people={people} themes={themes} lang={lang} />)}
      </div>
      <p class="empty" id="emptyMsg" hidden>{t('filter.empty')}</p>
    </div>
  </section>

  <section class="section" id="people">
    <div class="wrap">
      <div class="sec-head">
        <h2>{t('nav.people')}</h2>
        <p>{t('people.intro')}</p>
      </div>
      {
        pi && (
          <article class="pi">
            {pi.data.avatar && <Image src={pi.data.avatar} alt={pick(pi.data.name, lang)} width={400} />}
            <div class="pi-body">
              <p class="eyebrow">{t('role.pi')}</p>
              <h3>
                <a href={href(lang, `/people/${pi.id}/`)}>{pick(pi.data.name, lang)}</a>
                <small>{lang === 'zh' ? pi.data.name.en : pi.data.name.zh}</small>
              </h3>
              {pi.data.title && <p class="role">{pick(pi.data.title, lang)}</p>}
              {pi.data.bio && <p>{pick(pi.data.bio, lang)}</p>}
              <dl>
                <dt>{lang === 'zh' ? '研究领域' : 'Research'}</dt>
                <dd>{pick(pi.data.interests, lang)}</dd>
                {pi.data.email && (
                  <>
                    <dt>{t('people.email')}</dt>
                    <dd class="mail">{pi.data.email}</dd>
                  </>
                )}
              </dl>
            </div>
          </article>
        )
      }
      {
        groups.map((g) => (
          <div class="group">
            <h4>{t(`role.${g.role}`)}</h4>
            <div class="people">
              {g.members.map((m) => (
                <PersonCard person={m} projects={projectsOf(m.id, projects)} lang={lang} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div id="news" class="anchor">
        <div class="sec-head"><h2>{t('nav.news')}</h2></div>
        <ul class="news">
          {
            news.map((n) => (
              <li>
                <time datetime={n.data.date.toISOString().slice(0, 10)}>{fmtDate(n.data.date)}</time>
                <span>{n.data.link ? <a href={n.data.link}>{pick(n.data.text, lang)}</a> : pick(n.data.text, lang)}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div id="join" class="anchor">
        <div class="sec-head"><h2>{t('nav.join')}</h2></div>
        <div class="join">
          <h3>{t('join.title')}</h3>
          <p>{t('join.body')}</p>
          {
            pi?.data.email && (
              <p class="mail-row">
                <span class="mail">{pi.data.email}</span>
                <button class="copy" type="button" data-copy={pi.data.email.replace('(at)', '@')} data-done={t('join.copied')}>
                  {t('join.copy')}
                </button>
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Project filter: theme × type, shared by the theme cards and the chips.
  const state: Record<string, string> = { theme: '', type: '' };
  const rows = [...document.querySelectorAll<HTMLElement>('#projectList > article')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('#filters .chip')];
  const empty = document.getElementById('emptyMsg')!;

  function apply() {
    let shown = 0;
    for (const r of rows) {
      const ok = (!state.theme || r.dataset.theme === state.theme) && (!state.type || r.dataset.type === state.type);
      r.hidden = !ok;
      if (ok) shown++;
    }
    empty.hidden = shown > 0;
    for (const c of chips) c.setAttribute('aria-pressed', String(state[c.dataset.f!] === c.dataset.v));
  }

  for (const c of chips) {
    c.addEventListener('click', () => {
      state[c.dataset.f!] = c.dataset.v ?? '';
      apply();
    });
  }
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-pick-theme]')) {
    a.addEventListener('click', () => {
      state.theme = a.dataset.pickTheme!;
      state.type = '';
      apply();
    });
  }

  for (const b of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = b.dataset.done!;
      } catch {
        const sel = window.getSelection();
        const mail = b.previousElementSibling;
        if (sel && mail) sel.selectAllChildren(mail);
      }
    });
  }
</script>

<style>
  .hero { padding-block: 64px 8px; }
  .hero h1 { font-size: clamp(34px, 5vw, 60px); line-height: 1.08; max-width: 18em; margin-top: 14px; }
  .lede { max-width: 40em; font-size: 17px; color: var(--muted); margin: 20px 0 0; }
  /* The zh lede (53 chars at 17px, about 900px) fits on one line within --maxw; en keeps a readable measure. */
  .lede:lang(zh-CN) { max-width: none; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 560px;
    margin: 40px 0 0;
    border-top: 1px solid var(--line);
  }
  .stats div { padding-top: 12px; display: flex; flex-direction: column-reverse; }
  .stats dt { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .stats dd { margin: 0; font-family: var(--font-display); font-size: 30px; font-weight: 600; font-variant-numeric: tabular-nums; }

  .themes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .theme {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
  }
  .theme:hover { border-color: var(--accent); color: inherit; }
  .theme .code { font-family: var(--font-mono); font-size: 11.5px; color: var(--accent); letter-spacing: 0.1em; }
  .theme h3 { font-size: 18px; line-height: 1.25; }
  .theme p { margin: 0; font-size: 13.5px; color: var(--muted); }
  .theme .count { margin-top: auto; padding-top: 10px; border-top: 1px dashed var(--line); font-family: var(--font-mono); font-size: 12px; }
  @media (max-width: 980px) { .themes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .themes { grid-template-columns: 1fr; } }

  .filters { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-bottom: 4px; }
  .grp { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .lab { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-right: 4px; }
  .chip {
    font: inherit;
    font-size: 13px;
    color: var(--ink);
    background: var(--chip);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 12px;
    cursor: pointer;
  }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .list { border-top: 1px solid var(--line); margin-top: 16px; }
  .empty { padding: 28px; text-align: center; color: var(--muted); border: 1px dashed var(--line); border-radius: var(--radius); }

  .pi {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 32px;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin-bottom: 36px;
  }
  .pi :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 15%; border-radius: var(--radius); display: block; }
  .pi h3 { font-size: 28px; margin-top: 6px; }
  .pi h3 a { text-decoration: none; }
  .pi h3 small { font-family: var(--font-body); font-size: 16px; font-weight: 400; color: var(--muted); margin-left: 10px; }
  .pi .role { color: var(--accent); font-weight: 600; font-size: 14px; margin: 6px 0 12px; }
  .pi p { margin: 0 0 12px; max-width: 68ch; }
  .pi dl { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 6px 16px; margin: 14px 0 0; font-size: 14px; }
  .pi dt { font-family: var(--font-mono); font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); padding-top: 2px; }
  .pi dd { margin: 0; }
  .mail { font-family: var(--font-mono); font-size: 13.5px; user-select: all; }
  @media (max-width: 680px) { .pi { grid-template-columns: 1fr; } .pi :global(img) { max-width: 200px; } }

  .group { margin-bottom: 30px; }
  .group h4 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .group h4::after { content: ''; flex: 1; height: 1px; background: var(--line); }
  .people { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 980px) { .people { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .people { grid-template-columns: 1fr; } }

  .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; }
  @media (max-width: 820px) { .two { grid-template-columns: 1fr; } }
  .anchor { scroll-margin-top: 72px; }
  .news { list-style: none; margin: 0; padding: 0; }
  .news li { display: grid; grid-template-columns: 80px minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .news time { font-family: var(--font-mono); font-size: 12.5px; color: var(--muted); font-variant-numeric: tabular-nums; padding-top: 2px; }
  .join { background: var(--surface); border: 1px solid var(--line); border-top: 3px solid var(--accent); border-radius: var(--radius); padding: 24px; }
  .join h3 { font-size: 22px; margin-bottom: 10px; }
  .join p { margin: 0 0 14px; }
  .mail-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .mail-row .mail { background: var(--chip); padding: 5px 10px; border-radius: 4px; }
  .copy { font: inherit; font-size: 13px; color: var(--ink); background: transparent; border: 1px solid var(--line); border-radius: var(--radius); padding: 4px 10px; cursor: pointer; }
  .copy:hover { border-color: var(--accent); }
</style>
