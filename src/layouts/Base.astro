---
import '../styles/global.css';
import { href, languages, switchHref, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useT(lang);
const pageTitle = title ? `${title} · ${t('site.name')}` : `${t('site.name')} · PKU`;
const desc = description ?? t('site.description');
const path = Astro.url.pathname;
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const home = href(lang, '/');
const nav = [
  ['research', t('nav.research')],
  ['projects', t('nav.projects')],
  ['people', t('nav.people')],
  ['news', t('nav.news')],
  ['join', t('nav.join')],
] as const;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    {
      (Object.keys(languages) as Lang[]).map((l) => (
        <link rel="alternate" hreflang={l === 'zh' ? 'zh-CN' : 'en'} href={new URL(switchHref(path, l), Astro.site)} />
      ))
    }
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href={home}>
          <span class="mark" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
          <span>
            <span class="brand-name">{t('site.name')}</span>
            <small>{lang === 'zh' ? 'Urban Visual Intelligence Lab · PKU' : '北京大学 · 城市视觉智能实验室'}</small>
          </span>
        </a>
        <nav aria-label={lang === 'zh' ? '主导航' : 'Main'}>
          <ul class="nav">
            {nav.map(([id, label]) => <li><a href={`${home}#${id}`}>{label}</a></li>)}
          </ul>
          <a class="lang" href={switchHref(path, other)} hreflang={other} lang={other === 'zh' ? 'zh-CN' : 'en'}>
            {other === 'zh' ? '中文' : 'EN'}
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {t('site.name')} · {lang === 'zh' ? '北京大学' : 'Peking University'}</span>
        <span>{t('footer.address')}</span>
        <a href="https://github.com/Urban-Visual-Intelligence-PKU">GitHub</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .site-head .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 12px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    min-width: 0;
  }
  .brand:hover { color: inherit; }
  .brand-name { display: block; font-weight: 600; font-size: 14.5px; line-height: 1.3; }
  .brand small { display: block; color: var(--muted); font-size: 11.5px; line-height: 1.3; }
  .mark { width: 26px; height: 26px; flex: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
  .mark i { background: var(--ink); border-radius: 1px; }
  .mark i:nth-child(5) { background: var(--accent); }
  .mark i:nth-child(1), .mark i:nth-child(9) { opacity: 0.25; }
  nav { display: flex; align-items: center; gap: 22px; }
  .nav { display: flex; gap: 20px; list-style: none; margin: 0; padding: 0; font-size: 14px; }
  .nav a { text-decoration: none; color: var(--muted); }
  .nav a:hover { color: var(--ink); }
  .lang {
    font-family: var(--font-mono);
    font-size: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 3px 9px;
    text-decoration: none;
  }
  @media (max-width: 800px) { .nav { display: none; } }

  .site-foot {
    margin-top: 80px;
    border-top: 1px solid var(--line);
    padding-block: 24px calc(24px + env(safe-area-inset-bottom, 0px));
    font-size: 13px;
    color: var(--muted);
  }
  .site-foot .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; }
</style>
