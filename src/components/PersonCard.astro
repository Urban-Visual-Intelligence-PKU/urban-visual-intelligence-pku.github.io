---
import Avatar from './Avatar.astro';
import { href, pick, useT, type Lang, type UIKey } from '../i18n';
import { years, type Person, type Project } from '../lib/data';

interface Props {
  person: Person;
  projects: Project[];
  lang: Lang;
}
const { person, projects, lang } = Astro.props;
const t = useT(lang);
const d = person.data;
const name = pick(d.name, lang);
const altName = lang === 'zh' ? (d.name.zh ? d.name.en : '') : d.name.zh ?? '';
const page = href(lang, `/people/${person.id}/`);
const links = Object.entries(d.links).filter(([, url]) => url) as [string, string][];
---

<article class="person">
  <div class="top">
    <a class="av" href={page} tabindex="-1" aria-hidden="true"><Avatar person={person} size={56} square /></a>
    <div class="who">
      <a class="nm" href={page}><b>{name}</b>{altName && <span class="alt">{altName}</span>}</a>
      <span class="yr">{years(person)}{d.role === 'alumni' && d.now && ` · ${t('people.now')}: ${pick(d.now, lang)}`}</span>
    </div>
  </div>
  <p class="int">
    {pick(d.interests, lang)}
    {links.map(([k, url]) => (
      <>
        {' · '}
        <a href={url} target="_blank" rel="noopener">{t(`link.${k}` as UIKey)} ↗</a>
      </>
    ))}
  </p>
  {
    projects.length > 0 && (
      <ul class="chips" aria-label={t('people.projects')}>
        {projects.map((p) => {
          const title = pick(p.data.title, lang);
          return (
            <li>
              <a href={href(lang, `/projects/${p.id}/`)} title={title}>{p.data.short ?? title}</a>
            </li>
          );
        })}
      </ul>
    )
  }
</article>

<style>
  /* Fixed card size: every block has a fixed height, so cards line up in the grid.
     Interests and links flow as one paragraph clamped to 2 lines; chips clamp to 2 rows. */
  .person {
    --line-h: 21px;
    --chip-h: 24px;
    --chip-gap: 6px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: calc(32px + 2px + 56px + 10px + 2 * var(--line-h) + 10px + 2 * var(--chip-h) + var(--chip-gap));
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    min-width: 0;
    overflow: hidden;
  }
  .person:hover { border-color: var(--accent); }
  .top { display: flex; gap: 12px; align-items: center; min-width: 0; height: 56px; flex: none; }
  .av { display: block; flex: none; line-height: 0; }
  .who { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .nm { text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nm:hover b { color: var(--accent); }
  b { font-size: 18px; font-weight: 600; }
  .alt { font-size: 15px; color: var(--muted); margin-left: 8px; }
  .yr { font-size: 13px; color: var(--muted); }
  .yr:empty { display: none; }
  .int {
    flex: none;
    height: calc(2 * var(--line-h));
    margin: 0;
    font-size: 13.5px;
    line-height: var(--line-h);
    color: var(--muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .int a { color: var(--muted); text-underline-offset: 0.2em; white-space: nowrap; }
  .int a:hover { color: var(--accent); }
  .chips {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: var(--chip-gap) 5px;
    max-height: calc(2 * var(--chip-h) + var(--chip-gap));
    overflow: hidden;
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .chips li { max-width: calc(50% - 3px); }
  .chips a {
    display: block;
    max-width: 100%;
    height: var(--chip-h);
    line-height: var(--chip-h);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    background: var(--chip);
    border-radius: 3px;
    padding: 0 8px;
    font-size: 12.5px;
    text-decoration: none;
  }
  .chips a:hover { background: var(--accent); color: var(--accent-ink); }
</style>
